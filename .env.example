# URL privada del servidor FastAPI usada por /api/backend (no lleva secretos).
CIVIA_BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Exact public origin behind the HTTPS gateway (no trailing slash).
# Set only for the real deployment. Leave unset for local development.
# CIVIA_PUBLIC_ORIGIN=https://REPLACE_WITH_DOMAIN
